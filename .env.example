# Environment Variables for Coffee Sales Analysis
# Copy this file to .env and update with your actual credentials

# Database Credentials (PostgreSQL)
# These will override settings in config/config.yaml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coffee_sales_db
DB_USER=your_username
DB_PASSWORD=your_password

# Kaggle API Credentials (optional, if not using ~/.kaggle/kaggle.json)
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# Spark Configuration (optional overrides)
# SPARK_DRIVER_MEMORY=4g
# SPARK_EXECUTOR_MEMORY=4g
